# OurHomeInbox secrets.
#
# Copy this file to .env (in this same folder) and fill in every value, or
# let docker/deploy.sh do it for you. .env is never committed. Settings that
# are not secret go in config.yml.
#
# Write each value exactly as it is, with no quotes around it.

# ---------------------------------------------------------------------------
# Proton Mail Bridge
# ---------------------------------------------------------------------------

# The password the Bridge's "info" command prints. It is NOT your Proton
# password. The name must match "password_env" for the mailbox in config.yml.
# Each extra mailbox in config.yml gets its own line here, under its own name.
PROTON_BRIDGE_PASSWORD=
