# OurHomeInbox secrets.
#
# Copy this file to .env (in this same folder) and fill in every value, or
# let docker/deploy.sh do it for you. .env is never committed. Settings that
# are not secret go in config.yml.
#
# Write each value exactly as it is, with no quotes around it.

# ---------------------------------------------------------------------------
# Proton Mail Bridge
# ---------------------------------------------------------------------------

# The IMAP password the Bridge's "info" command prints. It is NOT your Proton
# password. The name must match "imap: password_env" for the mailbox in
# config.yml. Used once, when that mailbox is copied into OurHomeInbox's
# database at first start; after that, mailbox passwords are changed on the
# web page (Settings) and kept there, encrypted.
PROTON_BRIDGE_PASSWORD=

# ---------------------------------------------------------------------------
# The key that protects saved mailbox passwords
# ---------------------------------------------------------------------------

# 32 random bytes in base64. docker/deploy.sh makes it (or moves in the one
# OurHomeInbox made in data/secret.key). Keep it: without it, saved mailbox
# passwords cannot be opened and must be entered again.
OURHOMEINBOX_SECRET_KEY=
