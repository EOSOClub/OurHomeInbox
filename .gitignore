# This repo is public. Anything personal, secret, or read from someone's
# mailbox stays out of it. When in doubt, ignore it here first.

# ---------------------------------------------------------------------------
# Your settings and secrets. Only the templates (config.example.yml,
# .env.example) are public. .env* also covers backups like .env.bak.
# ---------------------------------------------------------------------------
/config.yml
/config.*.yml
!/config.example.yml
.env*
!.env.example
# Generated by docker/deploy.sh from config.yml.
.compose.env
# Local compose overrides often hold ports, paths or passwords.
docker-compose.override.yml
compose.override.yml
# Keys, certificates and sign-in tokens (Microsoft OAuth, API tokens, TLS).
# Folder patterns are anchored to the repo root so they never hide source
# folders of the same name (src/server/tokens/ is code, /tokens/ is not).
/secrets/
/tokens/
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
client_secret*.json
*credentials*.json
*.token
*.token.json
# Proton Bridge login state, if a Bridge is ever run from this repo.
/state/
/docker/*/state/

# ---------------------------------------------------------------------------
# Mail and documents. Everything captured from a mailbox is real, private mail:
# raw emails, attachments, link snapshots, bill photos and OCR output.
# Sanitized test fixtures will get an explicit exception when they exist.
# ---------------------------------------------------------------------------
/data/
/uploads/
/captures/
*.eml
*.msg
*.mbox
*.mbx
*.pst
*.ost

# ---------------------------------------------------------------------------
# Databases, dumps and backups
# ---------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
/dump/
*.bson
*.archive
*.bak
*.backup
*.orig
*~

# ---------------------------------------------------------------------------
# Dependencies, builds and test output
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
out/
.next/
next-env.d.ts
coverage/
.vitest/
test-results/
playwright-report/
blob-report/
.cache/
.turbo/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Logs. They can quote email content and settings.
# ---------------------------------------------------------------------------
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# IDE and local AI-assistant files (same as OurHomeWeb). The inspection
# profile, its scopes and the project dictionary are shared.
# ---------------------------------------------------------------------------
/.idea/*
!/.idea/inspectionProfiles/
!/.idea/scopes/
!/.idea/dictionaries/
.vscode/
*.swp
/.claude/
/CLAUDE.md
/AGENTS.md
# MCP client settings can hold API tokens.
.mcp.json

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
